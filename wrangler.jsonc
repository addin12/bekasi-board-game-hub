// Cloudflare Worker config. Secrets (BGG_TOKEN, BETTER_AUTH_SECRET, BETTER_AUTH_URL, GOOGLE_*, MAIL_*) are NOT here:
// locally they live in .dev.vars, deployed: `wrangler secret put <NAME> [--env staging]`.
// Top level = the real site. `env.staging` = the sandbox (fake data, test sign-in). Bindings and vars are per env.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bekasi-board-game-hub",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"vars": {
		"APP_NAME": "Bekasi Board Game Hub",
		// Comma-separated emails that may open /admin.
		"ADMIN_EMAILS": "bekasibgcom@gmail.com",
		"SANDBOX": "0"
	},
	"d1_databases": [
		{ "binding": "DB", "database_name": "bekasi-bgh", "database_id": "d795dcf3-535d-4cf6-b95f-072cb4ba8621", "migrations_dir": "drizzle" }
	],
	"r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "bekasi-bgh-uploads" }],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"env": {
		"staging": {
			"vars": {
				"APP_NAME": "Bekasi Board Game Hub (Sandbox)",
				"ADMIN_EMAILS": "bekasibgcom@gmail.com,admin@sandbox.test",
				// Turns on test sign-in for name@sandbox.test with code 000000. Never set this on the real site.
				"SANDBOX": "1"
			},
			"d1_databases": [
				{ "binding": "DB", "database_name": "bekasi-bgh-staging", "database_id": "c8a6431b-5fcd-48a5-8718-35a869dba332", "migrations_dir": "drizzle" }
			],
			"r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "bekasi-bgh-staging-uploads" }]
		}
	}
}
