{
  "name": "bekasi-board-game-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bekasi-bgh --local",
    "db:migrate:remote": "wrangler d1 migrations apply bekasi-bgh --remote"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "isbot": "^5.1.36",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
